# 服务监控与告警（mode 600, root:root）。修改后无需重启应用，下一次 timer 生效。
JOURNEY_MONITOR_URL=http://127.0.0.1:8766/api/health
JOURNEY_MONITOR_STATE=/var/lib/amphion-gjh/monitor.json
JOURNEY_PUBLIC_URL=https://amphion-gjh.amphiondev.com/

# 企业微信群机器人 webhook，形如 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
# 这是私密地址，不要提交到 Git，也不要贴进聊天；留空时只记录状态、不发送。
JOURNEY_ALERT_WEBHOOK=
