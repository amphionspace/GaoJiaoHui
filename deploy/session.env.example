# 会话记录（mode 600, root:root）。修改后 systemctl restart amphion-gjh。
# 关闭后不写入任何会话；已有记录仍可在看板查看或清空。
JOURNEY_SESSION_LOG=1
# 1 保存讲述原文；0 只保存手记/回信，不保存原文。
JOURNEY_SESSION_TRANSCRIPT=1
# 1-90 天，插入新记录时自动清理过期数据。
JOURNEY_SESSION_RETENTION_DAYS=7
# 最多保留条数。
JOURNEY_SESSION_MAX=500
# 音频：保存访客完整录音（最多 120 秒）、参考音（5-30 秒）与回信语音。
JOURNEY_SESSION_AUDIO=1
# 最多保留多少条带音频的会话，超出后删除最旧音频。
JOURNEY_SESSION_AUDIO_MAX=120
