# Add inside the server block that serves the booth (amphion-gjh.amphiondev.com).
# The voice detector ships a 14 MB onnxruntime wasm plus a 2 MB model; without
# compression a cold visit spends far longer than the start-up guard on them.

gzip on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types application/wasm application/octet-stream application/javascript
           text/javascript text/css application/json image/svg+xml text/plain;

# Vite hashes every file name, so the assets can be cached forever.
location /assets/ {
    proxy_pass http://127.0.0.1:8766;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    expires 30d;
    add_header Cache-Control "public, immutable";
}
