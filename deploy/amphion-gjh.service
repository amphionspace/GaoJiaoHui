[Unit]
Description=Amphion voice booth web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amphion
Group=amphion
WorkingDirectory=/opt/amphion-gjh/current
EnvironmentFile=/etc/amphion-gjh/runtime.env
ExecStart=/opt/amphion-gjh/current/.venv/bin/python -m server.main
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/amphion-gjh/current/.journey-state
UMask=0077

[Install]
WantedBy=multi-user.target
